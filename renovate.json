{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "dependencyDashboard": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 4,
  "branchPrefix": "renovate/",
  "rebaseWhen": "behind-base-branch",

  "enabledManagers": [
    "cargo",
    "npm",
    "dockerfile",
    "docker-compose",
    "helm-requirements",
    "helm-values",
    "pep621",
    "github-actions",
    "custom.regex"
  ],

  "cargo": {
    "managerFilePatterns": [
      "/(^|/)Cargo\\.toml$/"
    ]
  },

  "npm": {
    "managerFilePatterns": [
      "/(^|/)package\\.json$/",
      "/(^|/)package-lock\\.json$/"
    ]
  },

  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/|\\.)Dockerfile$/",
      "/(^|/)Dockerfile\\.[^/]*$/"
    ]
  },

  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)docker-compose[^/]*\\.ya?ml$/",
      "/(^|/)compose[^/]*\\.ya?ml$/"
    ]
  },

  "helm-requirements": {
    "managerFilePatterns": [
      "/(^|/)charts/[^/]+/Chart\\.yaml$/"
    ]
  },

  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)charts/[^/]+/values\\.ya?ml$/"
    ]
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update testcontainer image references in Rust integration tests",
      "managerFilePatterns": [
        "/(^|/)tests/.*_integration\\.rs$/"
      ],
      "matchStrings": [
        "GenericImage::new\\(\"(?<depName>[^\"]+)\",\\s*\"(?<currentValue>[^\"]+)\"\\)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Docker syntax directive in Dockerfiles",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "#\\s*syntax=docker/dockerfile:(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[0-9a-fA-F]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker/dockerfile"
    },
    {
      "customType": "regex",
      "description": "Update Rust CI image in build workflow docker run command",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/build\\.yml$/"
      ],
      "matchStrings": [
        "rust:(?<currentValue>[a-zA-Z0-9][a-zA-Z0-9._-]+)\\s+bash"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "rust"
    },
    {
      "customType": "regex",
      "description": "Update hardcoded Docker images in Helm template files",
      "managerFilePatterns": [
        "/(^|/)charts/[^/]+/templates/.*\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s+(?<depName>[a-zA-Z0-9_.\\-\\/]+):(?<currentValue>[a-zA-Z0-9_.\\-]+)\\s*$"
      ],
      "datasourceTemplate": "docker"
    }
  ],

  "packageRules": [
    {
      "description": "Group testcontainers and testcontainers-modules together",
      "matchPackageNames": ["testcontainers", "testcontainers-modules"],
      "groupName": "testcontainers",
      "groupSlug": "testcontainers"
    },
    {
      "description": "Group vite and @vitejs/plugin-react together — plugin-react major requires matching vite major",
      "matchPackageNames": ["vite", "@vitejs/plugin-react"],
      "groupName": "vite",
      "groupSlug": "vite"
    },
    {
      "description": "Group wasm-bindgen and js-sys together so Cargo.lock exact-version pins stay compatible",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["/^wasm-bindgen/", "js-sys", "web-sys"],
      "groupName": "wasm-bindgen",
      "groupSlug": "wasm-bindgen"
    },
    {
      "description": "Skip local-only observable-* Docker images that are built in-repo, not hosted on Docker Hub",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^observable-/"],
      "enabled": false
    },
    {
      "description": "Group non-major dependencies into a single PR",
      "groupName": "all-dependencies",
      "groupSlug": "all-dependencies",
      "matchPackageNames": ["/.*/", "!testcontainers", "!testcontainers-modules", "!vite", "!@vitejs/plugin-react", "!/^wasm-bindgen/", "!js-sys", "!web-sys"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "description": "Pin Docker digests for production base images",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest"],
      "pinDigests": true
    },
    {
      "description": "Tag testcontainer images with manual-update label",
      "matchManagers": ["custom.regex", "docker-compose"],
      "matchPackageNames": [
        "redpandadata/redpanda",
        "clickhouse/clickhouse-server",
        "postgres",
        "openfga/openfga",
        "rabbitmq"
      ],
      "addLabels": ["manual-update", "testcontainers"]
    }
  ]
}
