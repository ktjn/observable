// Domain: catalog (business service records, phase 1 S3). Not generated: the API types are
// hand-written in services/catalog-service/src/api.rs until the web module (phase 1 S8) consumes them.
domain catalog {
  owner: "service-management-lead"

  // Canonical catalog service record. Mirrors services/catalog-service/src/api.rs ServiceRow
  // field-for-field (table catalog.services, migration 048; tenant_id stays server-side). Aliases, owners and outcomes are child records of
  // the same aggregate and are returned on the service detail.
  @wire(json.fieldCase: "snake_case")
  entity BusinessService @ 1 (additive) {
    @key id: uuid
    businessName: string
    operationalName: string
    domain: string
    description: string
    criticality: enum(critical, high, standard, low)
    lifecycle: enum(planned, live, deprecated, retired)
    classification: enum(public, internal, confidential, restricted)
    supportRoute: string
    createdAt: timestamp
    updatedAt: timestamp
  }

  // Critical customer journey (table catalog.journeys, migration 051). Mirrors
  // services/catalog-service/src/journeys.rs JourneyRow field-for-field; ordered service links
  // live in catalog.journey_services and are returned on the journey detail.
  @wire(json.fieldCase: "snake_case")
  entity CriticalJourney @ 1 (additive) {
    @key id: uuid
    name: string
    description: string
    criticality: enum(critical, high, standard, low)
    inScope: bool
    scopeRationale: string
    classification: enum(public, internal, confidential, restricted)
    ownerKind?: enum(user, team)
    ownerId?: uuid
    createdAt: timestamp
    updatedAt: timestamp
  }

  // Coverage policy per criticality (table catalog.coverage_policies, migration 053; part of the
  // coverage-record data model). Mirrors
  // services/catalog-service/src/coverage.rs PolicyRow; approval is withdrawn on every change.
  @wire(json.fieldCase: "snake_case")
  entity CoveragePolicy @ 1 (additive) {
    @key criticality: enum(critical, high, standard, low)
    items: array<string>
    windowMinutes: int
    approvedBy?: uuid
    approvedAt?: timestamp
  }

  // Registered observability asset (table catalog.observability_assets, migration 053; part of
  // the coverage-record data model). Mirrors coverage.rs AssetRow.
  @wire(json.fieldCase: "snake_case")
  entity ObservabilityAsset @ 1 (additive) {
    @key externalId: string
    kind: enum(alert_rule, objective, dashboard, proactive_check, health_rule, runbook)
    owningComponent: string
    serviceId: uuid
    name: string
    ownerKind?: enum(user, team)
    ownerId?: uuid
    registeredAt: timestamp
    updatedAt: timestamp
  }

  // Coverage gap of a service item or a critical journey (table catalog.coverage_gaps,
  // migration 053; part of the coverage-record data model). Mirrors coverage.rs GapRow.
  @wire(json.fieldCase: "snake_case")
  entity CoverageGap @ 1 (additive) {
    @key id: uuid
    serviceId?: uuid
    journeyId?: uuid
    item: string
    state: enum(open, remediating, accepted, closed)
    remediationOwnerKind?: enum(user, team)
    remediationOwnerId?: uuid
    dueDate?: date
    reviewDate?: date
    acceptanceApprover?: uuid
    acceptanceRationale?: string
    closedReason?: enum(remediated, risk_accepted)
    createdAt: timestamp
    updatedAt: timestamp
  }

  // Material provider (table catalog.providers, migration 056; part of the provider-record data
  // model). Mirrors services/catalog-service/src/providers.rs ProviderRow.
  @wire(json.fieldCase: "snake_case")
  entity Provider @ 1 (additive) {
    @key id: uuid
    name: string
    kind: enum(cloud, saas, network, payment, data, other)
    material: bool
    contractRef: string
    contractOwnerKind?: enum(user, team)
    contractOwnerId?: uuid
    classification: enum(public, internal, confidential, restricted)
    createdAt: timestamp
    updatedAt: timestamp
  }

  // A function of a service or journey that depends on a provider (table
  // catalog.provider_dependencies, migration 056). An unregistered provider has no providerId.
  // Mirrors providers.rs DependencyRow.
  @wire(json.fieldCase: "snake_case")
  entity ProviderDependency @ 1 (additive) {
    @key id: uuid
    providerId?: uuid
    providerName: string
    serviceId?: uuid
    journeyId?: uuid
    function: string
  }
}
