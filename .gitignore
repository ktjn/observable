apps/frontend/test-results/*
.worktrees/
.env.local
target/
node_modules/
dist/

# Helm fetched chart dependencies — regenerated by `helm dependency update`
charts/*/charts/
scripts/__pycache__/
__pycache__/
**/__pycache__/

# Local Claude Code settings (user-specific, not shared)
.claude/settings.local.json

# modelable runtime - registry and compiled plans (generated, not committed)
.modelable/
.superpowers/

# modelable lock files written next to the models directory; the canonical,
# committed registry lock is registry-ids.lock at the repository root
models/registry-ids.lock
models/enum-numbers.lock

# TLA+ tool cache (pinned tla2tools.jar downloaded by scripts/run-formal-verification.sh)
.tla/
